      "value": "1",
      "type": "string"
    },
    {
      "key": "doctor_day_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "prescription_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "file_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "slot_date",
      "value": "25-11",
      "type": "string"
    },
