{
  "info": {
    "_postman_id": "6a0273e2-foundation-api-collection-v1",
    "name": "Foundation Medical API",
    "description": "Postman API collection for the Foundation Clinic/Hospital Management System (Laravel Passport).\n\n### Quick Start\n1. Set the `base_url` collection variable (default: `http://localhost:8000`, or `http://localhost/foundation/public` if using XAMPP directly).\n2. Run any **Register** or **Login** request — the Bearer `token` is automatically saved to the `{{token}}` collection variable.\n3. All requests include `Accept: application/json` (required by the backend to return JSON responses).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "doctor_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "1",
      "type": "string"
    },
    {
